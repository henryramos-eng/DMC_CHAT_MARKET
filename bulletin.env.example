TECHNICAL_EXCEL_PATH=data/technical/checklist_tecnico.xlsx
TECHNICAL_JSON_PATH=data/processed/technical/checklist_tecnico.json
BULLETIN_OUTPUT_DIR=data/generated/bulletins
BULLETIN_HISTORY_DAYS=60

# Generación editorial: openai, template o lora.
BULLETIN_TEXT_BACKEND=openai
# Vacío reutiliza OPENAI_LLM_MODEL del RAG.
BULLETIN_OPENAI_MODEL=
BULLETIN_OPENAI_TIMEOUT_SECONDS=60
# Si OpenAI falla, conserva la generación mediante reglas técnicas.
BULLETIN_LLM_FALLBACK=true

LORA_BASE_MODEL=
LORA_ADAPTER_PATH=
